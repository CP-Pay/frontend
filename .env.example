# CPPay Frontend Environment Variables

# Backend API Configuration
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
EXPO_PUBLIC_API_TIMEOUT=30000

# Blockchain Configuration
EXPO_PUBLIC_CHAIN_ID=4202
EXPO_PUBLIC_RPC_URL=https://rpc.sepolia-api.lisk.com
EXPO_PUBLIC_NETWORK=lisk-sepolia

# ERC-4337 Configuration
EXPO_PUBLIC_ENTRYPOINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
EXPO_PUBLIC_PAYMASTER_ADDRESS=0x1CCb27e4Cea6A4D689f97aFA1cbae8c9630516F6
EXPO_PUBLIC_SESSION_KEY_MODULE=0x20dfA3EE4033011a98cC88B55670dC6A4b344AC5

# Pimlico Bundler Configuration
EXPO_PUBLIC_PIMLICO_API_KEY=your-pimlico-api-key-here
EXPO_PUBLIC_BUNDLER_URL=https://api.pimlico.io/v1/lisk-sepolia/rpc

# 1inch DEX Configuration
EXPO_PUBLIC_ONE_INCH_API_KEY=your-1inch-api-key-here

# Token Addresses (Lisk Sepolia)
EXPO_PUBLIC_USDT_ADDRESS=0x0000000000000000000000000000000000000000
EXPO_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
EXPO_PUBLIC_CNGN_ADDRESS=0x0000000000000000000000000000000000000000

# Feature Flags
EXPO_PUBLIC_ENABLE_GAS_SPONSORSHIP=true
EXPO_PUBLIC_ENABLE_SWAP=true
EXPO_PUBLIC_ENABLE_PAYMENTS=true
EXPO_PUBLIC_ENABLE_KYC=true

# Debug Configuration
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=info
